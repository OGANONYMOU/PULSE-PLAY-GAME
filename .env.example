# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─── App (optional) ─────────────────────────────────────────────────────────
# Public URL used for OG tags / canonical links
VITE_APP_URL=https://pulseplay.gg

# ─── Email (optional – for transactional notifications) ─────────────────────
# If using Supabase Edge Functions + Resend or SendGrid:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OR
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@pulseplay.gg

# ─── Storage (optional override) ────────────────────────────────────────────
# Supabase Storage buckets are created via the SQL migrations.
# Bucket names referenced in code:
#   avatars   – user profile pictures
#   banners   – tournament / club banner images
#   clips     – user gameplay clips (video)
